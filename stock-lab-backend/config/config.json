{
  "app": {
    "number_of_threads": 1,
    "enable_session": false,
    "client_max_body_size": "1M",
    "client_max_memory_body_size": "64K",
    "log": {
      "use_spdlog": false,
      "log_level": "DEBUG"
    }
  },
  "custom_config": {
    "app_name": "Stock Lab",
    "mail": {
      "from": "support@mengyv.com",
      "verify_code_template": "../templates/email/code.html",
      "transaction_remind_template": "../templates/email/transaction-remind.html"
    },
    "resend": {
      "api_key": "${MAIL_API_KEY}"
    },
    "finnhub": {
      "url": "https://finnhub.io",
      "search_path": "/api/v1/search",
      "quote_path": "/api/v1/quote",
      "token": "${FINNHUB_TOKEN}"
    }
  }
}
