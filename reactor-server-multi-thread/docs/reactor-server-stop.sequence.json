  "cards": [
    {
      "dot": "cyan",
      "title": "停止入口",
      "items": [
        "EchoServer::stop 是当前业务层停止入口。",
        "它先关闭 EchoServer 自己的 worker ThreadPool，再进入 TcpServer::stop。"
      ]
    },
    {
      "dot": "emerald",
      "title": "事件循环退出",
      "items": [
        "EventLoop::stop 设置 is_stopped=true。",
        "wakeup() 写 eventfd，唤醒可能阻塞在 epoll_wait 的线程。",
        "EventLoop::run 的 while(!is_stopped) 条件失败后退出。"
      ]
    },
    {
      "dot": "amber",
      "title": "当前边界",
      "items": [
        "TcpServer::stop 没有显式清理 conns_ 或逐个关闭 Connection。",
        "ThreadPool::shutdown 会等待队列中已有任务执行完再退出。"
      ]
    }
  ]
}
